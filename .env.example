#--- Common ---
# npx supabase statusで確認できる情報を設定してください
SUPABASE_URL=http://127.0.0.1:54421
# `npx supabase status` の "Secret" を設定してください
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
# `npx supabase status` の "Publishable" を設定してください
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Web側のキャッシュを無効化するためのシークレットキー
REVALIDATE_SECRET=your-secret-key-here
# --- AI（web / admin / worker 共通。横展開先では本番も変更可能） ---
# この案件では Bedrock のみ。複数使う場合: bedrock,gateway,openai,google
AI_ALLOWED_PROVIDERS=bedrock
# provider:modelId 形式。未設定時は用途ごとの Bedrock 既定値を使う。
# AI_DEFAULT_MODEL=bedrock:jp.anthropic.claude-sonnet-4-6
# 個別指定（DB/UI） > 用途別 env > AI_DEFAULT_MODEL > 用途ごとの既定値
# AI_CHAT_MODEL=
# AI_INTERVIEW_MODEL=
# AI_SUMMARY_MODEL=
# AI_MODERATION_MODEL=
# AI_CONTENT_RICHNESS_MODEL=
# AI_CONFIG_GENERATION_MODEL=
# AI_SIMULATION_MODEL=
# AI_TOPIC_ANALYSIS_MODEL=
# AI_TOPIC_WRITING_MODEL=
# AI_OPINION_BACKFILL_MODEL=
# AI_OPINION_TAGS_MODEL=
# 単価表にないモデルをwebチャットで使う場合は経路別の単価（USD/100万token）を指定。
# AI_MODEL_PRICING='{"openai:gpt-4o":{"inputTokensPerMillionUsd":2.5,"outputTokensPerMillionUsd":10}}'
# Vercel は AWS_REGION を自動設定するため、プロジェクト環境変数で明示する。
AWS_REGION=ap-northeast-1
# ローカル: 自分の AWS SSO プロファイルを指定。Vercel/ECS には設定しない。
# AWS_PROFILE=saga-koucho-dev
# Vercel: OIDCのIAMロールARNを設定。ローカル/ECSではcredential chainを使用。
AWS_ROLE_ARN=
# Guardrail を使う場合はIDとバージョンを両方設定（Bedrockのみ適用）。
# AWS_BEDROCK_GUARDRAIL_ID=
# AWS_BEDROCK_GUARDRAIL_VERSION=
# 以下は各プロバイダーを選択した場合のみ必要。
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# AdminサーバーのURL（web/admin両方で使用）
ADMIN_URL=http://localhost:3001

#--- Web ---
# Basic認証をONにする場合は設定してください
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# Langfuse設定（プロンプト管理・LLM監視）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# AI Chatの日次コストリミット（USD）- ユーザー単位（旧名 CHAT_DAILY_COST_LIMIT_USD もフォールバックとして有効）
CHAT_DAILY_USER_COST_LIMIT_USD=
# AI Chatの日次コストリミット（USD）- システム全体
CHAT_DAILY_TOTAL_COST_LIMIT_USD=
# AI Chatの月間コストリミット（USD）- システム全体
CHAT_MONTHLY_TOTAL_COST_LIMIT_USD=

# --- ブランドアセット差し替え（fork向け・任意） ---
# インタビューチャットのAIアバター画像パス。未設定時は /icons/ai-chat.svg を表示
# public/ 配下のローカルパスを指定（外部URLは images.remotePatterns への追加が必要）。ビルド時に設定されている必要あり
NEXT_PUBLIC_BRAND_CHAT_AVATAR_SRC=

# --- Admin ---
# WebサーバーのURLを設定してください
NEXT_PUBLIC_WEB_URL=http://localhost:3000
# MCPサーバー（/api/mcp）へのBearer認証トークン。mirai-gikai-content のエージェント等から接続するときに使用する。
ADMIN_MCP_TOKEN=

# --- Supabase Auth (Google OAuth) ---
# Google OAuth用の設定（本番・staging環境で必要）
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# OAuthコールバックURL（config.tomlのadditional_redirect_urlsで参照、ADMIN_URL + /api/auth/callback）
ADMIN_AUTH_CALLBACK_URL=http://localhost:3001/api/auth/callback
