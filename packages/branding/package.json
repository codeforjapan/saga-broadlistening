{
  "name": "@mirai-gikai/branding",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tsx src/generate-css.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    "./tokens.css": "./tokens.css",
    "./brand-meta": {
      "types": "./src/brand-meta.ts",
      "default": "./src/brand-meta.ts"
    },
    "./palette": {
      "types": "./src/palette.ts",
      "default": "./src/palette.ts"
    },
    "./contrast": {
      "types": "./src/contrast.ts",
      "default": "./src/contrast.ts"
    },
    "./site": {
      "types": "./src/site.ts",
      "default": "./src/site.ts"
    },
    "./assets": {
      "types": "./src/assets.ts",
      "default": "./src/assets.ts"
    }
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "vitest": "^3.2.4"
  }
}
